# Public entry point. Everything outside the compose network arrives here.
#
# Local dev binds plain HTTP on :3015. On a VPS, replace the site address with your
# domain and Caddy provisions TLS automatically (see docs/DEPLOY_VPS.md).

{
	# Caddy's own admin API stays off the public interface.
	admin off
	auto_https off
}

:3015 {
	encode gzip zstd

	log {
		output stdout
		format console
	}

	# --- MCP: Streamable HTTP transport, bearer-token guarded ------------------
	# Matched before /api so the longer prefix wins regardless of ordering.
	handle /mcp* {
		reverse_proxy mcp:3018 {
			# SSE and streaming responses must not be buffered.
			flush_interval -1
		}
	}

	# --- REST API -------------------------------------------------------------
	handle /api* {
		reverse_proxy api:3017 {
			# Agent runs stream trace events over SSE; buffering would defeat them.
			flush_interval -1
		}
	}

	# --- Web app --------------------------------------------------------------
	# Last, so it acts as the catch-all for the SPA and its assets.
	handle {
		reverse_proxy web:3016
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
