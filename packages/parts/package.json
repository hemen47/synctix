{
  "name": "@syntrix/parts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@syntrix/core": "workspace:*",
    "@syntrix/shared": "workspace:*",
    "@tscircuit/footprinter": "0.0.426",
    "@tscircuit/parts-engine": "0.0.32",
    "circuit-json": "0.0.491",
    "easyeda-converter": "0.0.2",
    "kicad-converter": "0.0.17",
    "kicad-mod-converter": "0.0.30",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.2"
  }
}
