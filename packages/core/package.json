{
  "name": "@syntrix/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tsx": {
      "types": "./src/tsx-entry.ts",
      "default": "./src/tsx-entry.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@syntrix/shared": "workspace:*",
    "@tscircuit/eval": "0.0.1402",
    "@tscircuit/props": "0.0.653",
    "circuit-json": "0.0.491",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "circuit-to-svg": "0.0.416",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
