# Copy to .env and fill in. Secrets are server-side only — nothing here is ever exposed
# to the browser bundle. The web app talks to the API, and the API holds the keys.

# ---------------------------------------------------------------- core
NODE_ENV=development
LOG_LEVEL=info

# Public entry point. Caddy listens here and routes to web/api/mcp.
PUBLIC_PORT=3015
# Public origin, used for CORS and for absolute artifact URLs.
PUBLIC_ORIGIN=http://localhost:3015

# ---------------------------------------------------------------- service ports
WEB_PORT=3016
API_PORT=3017
MCP_PORT=3018
KICAD_PORT=3019
SIM_PORT=3020
FREEROUTING_PORT=3021
PYTOOLS_PORT=3022

# ---------------------------------------------------------------- datastores
MONGO_URL=mongodb://mongo:27017/syntrix
REDIS_URL=redis://redis:6379

MEILI_URL=http://meilisearch:7700
# Meilisearch refuses to start in production without a key of at least 16 bytes.
MEILI_MASTER_KEY=change-me-to-a-long-random-string

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=syntrix
MINIO_SECRET_KEY=change-me-too
MINIO_BUCKET=syntrix-artifacts

# ---------------------------------------------------------------- internal services
# Node services reach the native-tool containers over the compose network.
KICAD_SERVICE_URL=http://kicad:3019
SIM_SERVICE_URL=http://sim:3020
FREEROUTING_SERVICE_URL=http://freerouting:3021
PYTOOLS_SERVICE_URL=http://pytools:3022

# ---------------------------------------------------------------- auth
# Single-tenant v1: one shared API key. The user model comes later, and the header name
# stays the same when it does.
SYNTRIX_API_KEY=dev-key-change-me
# Bearer token for the Streamable HTTP MCP transport behind Caddy at /mcp.
MCP_BEARER_TOKEN=dev-mcp-token-change-me

# ---------------------------------------------------------------- LLM providers
# Only the provider(s) referenced by config/models.yaml need a key. A provider with no
# key reports as unavailable; it does not crash the agent.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434/api

# Per-role overrides, if you want to change a model without editing models.yaml.
# SYNTRIX_MODEL_PLANNER=anthropic/claude-opus-4.5
# SYNTRIX_MODEL_EXECUTOR=anthropic/claude-sonnet-4.5

# ---------------------------------------------------------------- parts sources
# Each adapter is optional. Missing credentials mean that source reports "disabled" and
# is skipped during federated search — never an error.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# Sandbox until your DigiKey app is approved for production.
DIGIKEY_BASE_URL=https://sandbox-api.digikey.com

NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

MOUSER_API_KEY=

# LCSC/EasyEDA and the KiCad libraries need no credentials.
LCSC_ENABLED=true
KICAD_LIBS_ENABLED=true
# Local checkout paths for the KiCad symbol/footprint libraries (see Makefile targets).
KICAD_SYMBOLS_PATH=./vendor/kicad-symbols
KICAD_FOOTPRINTS_PATH=./vendor/kicad-footprints
