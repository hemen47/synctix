# Copy to .env and fill in. Secrets are server-side only — nothing here is ever exposed
# to the browser bundle. The web app talks to the API, and the API holds the keys.

# ---------------------------------------------------------------- core
NODE_ENV=development
LOG_LEVEL=info

# Public entry point. Caddy listens here and routes to web, /api and /mcp.
PUBLIC_PORT=3015
# Public origin, used for CORS and for absolute artifact URLs.
PUBLIC_ORIGIN=http://localhost:3015

# ---------------------------------------------------------------- service ports
WEB_PORT=3016
API_PORT=3017
# Profile `kicad` only.
KICAD_PORT=3019

# ---------------------------------------------------------------- datastores
# MongoDB runs on the host in development — there is no container for it.
#
# NOTE: a database name is a single name, not a path. MongoDB forbids / \ . " $ * < > : |
# and ? in a namespace, so "…/vikronix/syntrix" connects and then fails on every query
# with "Invalid namespace specified". Use one name.
MONGO_URL=mongodb://127.0.0.1:27017/vikronix_syntrix

# Unset MONGO_URL entirely to run with an in-memory store. Designs then live for the life
# of the process — fine for a first look or for the Playwright suite, not for real work.

# DNS for `mongodb+srv://` (Atlas). The driver resolves SRV records before it can connect,
# so a machine whose resolver is a local stub that is not answering fails with
# ECONNREFUSED and an error that names DNS rather than Mongo. This overrides the resolver
# for the API process only; it changes nothing on the machine.
# MONGO_DNS_SERVERS=8.8.8.8,8.8.4.4

# Exports, waveform vectors and other generated files. A plain local volume — there is
# no object store in v2.
ARTIFACTS_DIR=./data/artifacts

# ---------------------------------------------------------------- auth
# Single-tenant v1: one shared API key. The user model comes later, and the header name
# stays the same when it does.
SYNTRIX_API_KEY=dev-key-change-me
# Bearer token for the Streamable HTTP MCP transport, served by the api at /mcp.
MCP_BEARER_TOKEN=dev-mcp-token-change-me

# ---------------------------------------------------------------- LLM providers
# Only the provider(s) referenced by config/models.yaml need a key. A provider with no
# key reports as unavailable; it does not crash the agent.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434/api

# Per-role overrides, if you want to change a model without editing models.yaml.
# SYNTRIX_MODEL_PLANNER=anthropic/claude-opus-4.5
# SYNTRIX_MODEL_EXECUTOR=anthropic/claude-sonnet-4.5

# ---------------------------------------------------------------- parts sources
# Each adapter is optional. Missing credentials mean that source reports "disabled" and
# is skipped during federated search — never an error.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# Sandbox until your DigiKey app is approved for production.
DIGIKEY_BASE_URL=https://sandbox-api.digikey.com

NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=

MOUSER_API_KEY=

# LCSC/EasyEDA and the KiCad libraries need no credentials.
LCSC_ENABLED=true
KICAD_LIBS_ENABLED=true
# Local checkout paths for the KiCad symbol/footprint libraries (see Makefile targets).
KICAD_SYMBOLS_PATH=./vendor/kicad-symbols
KICAD_FOOTPRINTS_PATH=./vendor/kicad-footprints

# ================================================================ optional profiles
# None of the following is needed by the four required services. Set them only when you
# enable the matching compose profile (see the Makefile's PROFILES variable).

# --- profile `kicad`: kicad-cli ERC/DRC/export wrapper
# KICAD_SERVICE_URL=http://kicad:3019

# --- profile `indexing`: redis + BullMQ worker for bulk parts ingestion.
# Unset, the same job handlers run in-process in the api against a Mongo-backed queue.
# REDIS_URL=redis://redis:6379

# --- profile `search`: Meilisearch parts index behind the same PartsIndex interface as
# the default Mongo text index. Meilisearch refuses to start in production without a key
# of at least 16 bytes.
# MEILI_URL=http://meilisearch:7700
# MEILI_MASTER_KEY=change-me-to-a-long-random-string
