# Copy to .env and fill in. Secrets are server-side only — nothing here reaches the
# browser bundle. The web app talks to the API, and the API holds the keys.
#
# Every variable below is read by the code. There is nothing here for a container,
# because there are no containers: SYNTRIX is one Node process (ADR-0029).

# ---------------------------------------------------------------- core
NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------- ports
# One public port, 3015, in development and in production alike.
#
#   development  Vite serves the app on WEB_PORT and proxies /api and /mcp to API_PORT.
#   production   the API process serves the app, /api and /mcp on WEB_PORT itself, and
#                API_PORT is unused.
#
# The browser only ever sees WEB_PORT. API_PORT is an internal detail of `pnpm dev`.
WEB_PORT=3015
API_PORT=3016

# Used for CORS. In production set it to the origin the app is actually served from.
PUBLIC_ORIGIN=http://localhost:3015

# ---------------------------------------------------------------- database
# MongoDB runs on the host in development and is Atlas in production — never a container.
# Leave it unset to run with an in-memory store: a supported way to run, not a degraded
# one, and what the Playwright suite drives.
#
# Two traps worth knowing: a database name containing `/` connects and then fails every
# query, and a mongodb+srv:// URL needs a DNS resolver that answers.
MONGO_URL=mongodb://127.0.0.1:27017/vikronix_syntrix
# Only needed for mongodb+srv:// (Atlas) behind a local stub resolver.
MONGO_DNS_SERVERS=

# ---------------------------------------------------------------- auth
# Single-tenant v1: one shared API key. Unset in development means no auth at all.
SYNTRIX_API_KEY=
# Bearer token for the Streamable HTTP MCP transport at /mcp.
MCP_BEARER_TOKEN=

# ---------------------------------------------------------------- LLM providers
# Only the provider(s) referenced by config/models.yaml need a key. A provider with no
# key reports as unavailable; it does not crash the agent.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OLLAMA_BASE_URL=

# Per-role overrides, if you want to change a model without editing models.yaml.
# SYNTRIX_MODEL_PLANNER=
# SYNTRIX_MODEL_EXECUTOR=

# Runs the agent eval against a real model instead of skipping it.
# SYNTRIX_EVAL_LIVE=1

# Where on-disk data lives — the parts you define yourself land in
# <SYNTRIX_DATA_DIR>/parts/user-parts.json. Defaults to ./data in the repo root, found by
# walking up rather than from the working directory, because the api is started from
# apps/api in development and from dist/ in production.
SYNTRIX_DATA_DIR=

# ---------------------------------------------------------------- parts sources
# Each adapter is optional. Missing credentials mean that source reports "disabled" and
# is skipped during federated search — never an error.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# Sandbox until your DigiKey app is approved for production.
DIGIKEY_BASE_URL=https://sandbox-api.digikey.com

# LCSC/EasyEDA needs no credentials.
LCSC_ENABLED=true

# A local checkout of the KiCad footprint library, read straight off disk.
KICAD_FOOTPRINTS_PATH=
