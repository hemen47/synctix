{
  "name": "syntrix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "prepare": "husky",
    "demo": "tsx scripts/demo-engine.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@syntrix/core": "workspace:*",
    "@syntrix/parts": "workspace:*",
    "@syntrix/shared": "workspace:*",
    "@tscircuit/copper-pour-solver": "^0.0.54",
    "@tscircuit/eval": "0.0.1402",
    "@tscircuit/infer-cable-insertion-point": "^0.0.4",
    "@tscircuit/krt-wasm": "^0.1.9",
    "@tscircuit/miniflex": "^0.0.4",
    "@tscircuit/schematic-trace-solver": "^0.0.196",
    "@tscircuit/soup-util": "^0.0.41",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "2.1.9",
    "calculate-elbow": "^0.0.13",
    "circuit-json": "0.0.491",
    "connectivity-map": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "flatbush": "^4.6.2",
    "husky": "^9.1.7",
    "minicssgrid": "^0.0.9",
    "prettier": "^3.4.2",
    "react": "19.3.0",
    "spicey": "^0.0.14",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8",
    "zod": "3.24.1"
  }
}
