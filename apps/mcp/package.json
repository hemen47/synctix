{
  "name": "@syntrix/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "syntrix-mcp": "dist/stdio.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest --passWithNoTests",
    "test:run": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@syntrix/shared": "workspace:*",
    "@syntrix/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "^4.21.2",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
